# Copie para .env e ajuste. Nenhuma credencial é necessária: tudo roda localmente.
ZELA_LLM=Qwen/Qwen2.5-1.5B-Instruct
ZELA_EMB=intfloat/multilingual-e5-small
ZELA_BUSCA=e5
ZELA_TOPK=3
# ZELA_LIMIAR=0.82          # se vazio, usa o valor calibrado em avaliacao/limiar.json
ZELA_CONFIG=C               # configuração servida pela API (A, B ou C)
ZELA_GERADOR=hf             # hf (transformers + LoRA) ou ollama
ZELA_CORS=http://localhost:3000
# Chave exigida no cabeçalho X-API-Key do /perguntar (deixe vazio para desligar). Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ZELA_API_KEY=
